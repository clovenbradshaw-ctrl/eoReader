      "parameters": {
        "jsCode": "const item = $input.first();\nlet text = typeof item.json === 'string' ? item.json : (item.json?.data || JSON.stringify(item.json));\nconst lines = text.trim().split('\\n').filter(l => l.trim());\nconst posts = [];\nfor (const line of lines) {\n  try { posts.push(JSON.parse(line)); } catch {}\n}\nconst query = $('Feed Webhook').first().json.query || {};\nlet filtered = posts;\nif (query.slug) filtered = filtered.filter(p => p.slug === query.slug);\nif (query.op) filtered = filtered.filter(p => p.op === query.op);\nif (query.site) filtered = filtered.filter(p => p.site === query.site);\nconst limit = parseInt(query.limit) || 0;\nif (limit > 0) filtered = filtered.slice(-limit);\nreturn [{ json: { posts: filtered, count: filtered.length, total: posts.length } }];"
