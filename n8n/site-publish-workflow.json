      "parameters": {
        "jsCode": "// Resolve + sanitize the target file from the client's body.filename.\n// Falls back to eo-log.jsonl so legacy callers keep working.\nconst body = $input.first().json.body || {};\nlet filename = body.filename || 'eo-log.jsonl';\n// Only allow alphanumerics, hyphens, underscores, dots, slashes.\nfilename = filename.replace(/[^a-zA-Z0-9\\-_.\\/]/g, '');\n// Prevent directory traversal.\nfilename = filename.replace(/\\.\\./g, '');\nif (!filename) throw new Error('Invalid filename');\nreturn [{ json: { body, filename } }];"
      },
