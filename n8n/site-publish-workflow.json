      "parameters": {
        "jsCode": "// Route the appended line to the file named by the client (body.filename).\n// Falls back to eo-log.jsonl so legacy callers keep working.\nconst prev = $input.first().json;\nconst body = $('Auth').first().json.body;\nconst filename = body.filename || 'eo-log.jsonl';\n\nlet existing = '';\nlet sha = null;\nif (prev && prev.content) {\n  existing = Buffer.from(prev.content, 'base64').toString('utf-8');\n  sha = prev.sha;\n}\n\n// Log every field the client sent (op, site, slug, title, stance, terrain,\n// author, meta, payload, hash, ...) except the routing-only `filename`.\nconst entry = { ts: new Date().toISOString() };\nfor (const k in body) {\n  if (k === 'filename') continue;\n  entry[k] = body[k];\n}\n\nconst line = JSON.stringify(entry);\nconst updated = existing\n  ? (existing.endsWith('\\n') ? existing + line + '\\n' : existing + '\\n' + line + '\\n')\n  : line + '\\n';\n\nconst result = {\n  filename,\n  message: `${body.op || 'append'}(${body.site || '-'}, ${body.slug || '-'})`,\n  content: Buffer.from(updated, 'utf-8').toString('base64')\n};\nif (sha) result.sha = sha;\n\nreturn [{ json: result }];"
      },
