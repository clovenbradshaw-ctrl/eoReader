    {
      "parameters": {
        "jsCode": "// Append one JSONL line to the file named by the client. If GH Get File\n// 404'd (file does not exist yet) there is no sha and the PUT below creates\n// it -- so no separate seed step is needed.\nconst prev = $input.first().json;\nconst resolved = $('Resolve File').first().json;\nconst body = resolved.body;\nconst filename = resolved.filename;\n\nlet existing = '';\nlet sha = null;\nif (prev && prev.content) {\n  existing = Buffer.from(prev.content, 'base64').toString('utf-8');\n  sha = prev.sha;\n}\n\n// Log every field the client sent (op, site, slug, title, stance, terrain,\n// author, meta, payload, hash, ...) except the routing-only `filename`.\nconst entry = { ts: new Date().toISOString() };\nfor (const k in body) {\n  if (k === 'filename') continue;\n  entry[k] = body[k];\n}\n\nconst line = JSON.stringify(entry);\nconst updated = existing\n  ? (existing.endsWith('\\n') ? existing + line + '\\n' : existing + '\\n' + line + '\\n')\n  : line + '\\n';\n\nconst result = {\n  filename,\n  message: `${body.op || 'append'}(${body.site || '-'}, ${body.slug || '-'})`,\n  content: Buffer.from(updated, 'utf-8').toString('base64')\n};\nif (sha) result.sha = sha;\n\nreturn [{ json: result }];"
      },
